(* Translation-intrinsically-before *)
let tr-ib =
  [Imp & TTD & R]; iico_data; [B]; iico_ctrl; [Exp & M | MMU & FAULT]

let TTD-mismatched-attrs = [Imp & TTD & R]; ~TTD-same-attrs; [Imp & TTD & R]

let mismatched-attrs =
  if "vmsa" then
     ([Exp & M]; tr-ib^-1; TTD-mismatched-attrs; tr-ib; [Exp & M]) & loc
  else
     0

(* Notions of Same Location - PA, VA, and including Fault Effects *)
let TTD-same-oa =  same-oa(TTD*TTD) 
let same-loc = ([M]; loc \ mismatched-attrs; [M])
  | [MMU & Translation & FAULT]; same-low-order-bits
  | same-low-order-bits; [MMU & Translation & FAULT] 

let po-loc = po & same-loc

(* Same-cache-line relation *)
(* NOTE : currently assumes all locations are on different cache lines *)
(*        also extends to IC without a location specified              *)
let scl = loc
  | (M | DC.CVAU | IC) * (IC.IALLU | IC.IALLUIS)
  | (IC.IALLU | IC.IALLUIS) * (M | DC.CVAU | IC)
 
let va-loc = (tr-ib; same-low-order-bits; tr-ib^-1) & loc
let po-va-loc = po & va-loc

let WB = range([iWB & oWB]; tr-ib; [M & Exp | DC | IC])
let WT = range([iWT & oWT]; tr-ib; [M & Exp | DC | IC])
let NC = range([iNC & oNC]; tr-ib; [M & Exp | DC | IC])
let Device-GRE = range([Device-GRE]; tr-ib; [M & Exp | DC | IC])
let Device-nGRE = range([Device-nGRE]; tr-ib; [M & Exp | DC | IC])
let Device-nGnRE = range([Device-nGnRE]; tr-ib; [M & Exp | DC | IC])
let Device-nGnRnE = range([Device-nGnRnE]; tr-ib; [M & Exp | DC | IC])

(* All Effects that are not permitted to be cached *)
let UC = (if "T00" then WT else {}) | NC | Device-GRE | Device-nGRE | Device-nGnRE | Device-nGnRnE

let same-ch = if "vmsa" then
            [WB]; loc; [WB]
            | [WT]; loc; [WT]
            | [UC]; loc; [UC]
            else loc
