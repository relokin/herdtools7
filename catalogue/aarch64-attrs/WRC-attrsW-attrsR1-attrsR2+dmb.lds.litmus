AArch64 WRC-<attrsW>-<attrsR1>-<attrsR2>+dmb.lds
Variant=vmsa
{
 [x]=0;
 [PTE(x)]=(oa:PA(x), attrs:(<attrsW>));
 [PTE(y)]=(oa:PA(x), attrs:(<attrsR1>));
 [PTE(z)]=(oa:PA(x), attrs:(<attrsR2>));
 0:X0=x; 1:X1=y; 2:X2=z;
 1:X3=f; 2:X3=f;
}
 P0          | P1           | P2          ;
 MOV W4,#1   | LDR W4,[X1]  | LDR W5,[X3] ;
 STR W4,[X0] | DMB LD       | DMB LD      ;
             | MOV W5,#1    | LDR W4,[X2] ;
             | STR W5,[X3]  |             ;
exists(1:X4=1 /\  2:X5=1 /\ 2:X4=0)
