AArch64 MP+GRE-dmb.st+dmb.ld-WB
Variant=vmsa
{
 [PTE(x)]=(oa:PA(x),attrs:(Device-GRE));
 [PTE(y)]=(oa:PA(x),attrs:(Normal,iWB,oWB));
 0:X1=x; 0:X3=f;
 1:X1=y; 1:X3=f;
}
 P0          | P1          ;
 MOV W0,#1   | LDR W2,[X3] ;
 STR W0,[X1] | DMB LD      ;
 DMB ST      | LDR W0,[X1] ;
 MOV W2,#1   |             ;
 STR W2,[X3] |             ;
exists(1:X2=1 /\ 1:X0=0)
