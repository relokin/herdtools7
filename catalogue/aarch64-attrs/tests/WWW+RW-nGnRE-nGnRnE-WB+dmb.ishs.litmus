AArch64 WWW+RW-nGnRE-nGnRnE-WB+dmb.ishs
Variant=vmsa
{
 [x]=0;
 [PTE(x)]=(oa:PA(x), attrs:(Device-nGnRE));
 [PTE(y)]=(oa:PA(x), attrs:(Device-nGnRnE));
 [PTE(z)]=(oa:PA(x), attrs:(Normal,iWB,oWB));
 0:X0=x; 1:X1=y; 2:X2=z;
 1:X3=f; 2:X3=f;
}
 P0          | P1           | P2          ;
 MOV W4,#1   | MOV W4,#2    | LDR W5,[X3] ;
 STR W4,[X0] | STR W4,[X1]  | DMB ISH     ;
             | DMB ISH      | MOV W4,#3   ;
             | MOV W5,#1    | STR W4,[X2] ;
             | STR W5,[X3]  |             ;
exists([x]=2 /\ 2:X5=1)
