Variant=vmsa
{
 [x]=0;
 [PTE(x)]=(oa:PA(x),attrs:(Normal,iWB,oWB));
 [PTE(y)]=(oa:PA(x),attrs:(Normal,iNC,oNC));
 [PTE(z)]=(oa:PA(x),attrs:(Normal,iWB,oWB));
 0:X1=x; 0:X3=y;
