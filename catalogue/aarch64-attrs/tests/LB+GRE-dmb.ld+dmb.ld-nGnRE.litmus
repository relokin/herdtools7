AArch64 LB+GRE-dmb.ld+dmb.ld-nGnRE
Variant=vmsa
{
 [PTE(x)]=(oa:PA(x),attrs:(Device-GRE));
 [PTE(y)]=(oa:PA(x),attrs:(Device-nGnRE));
 0:X1=x; 0:X3=f;
 1:X2=y; 1:X3=f;
}
 P0          | P1          ;
 LDR W0,[X1] | LDR W4,[X3] ;
 DMB LD      | DMB LD      ;
 MOV W4,#1   | MOV W0,#1   ;
 STR W4,[X3] | STR W0,[X2] ;
exists(1:X4=1 /\ 0:X0=1)
