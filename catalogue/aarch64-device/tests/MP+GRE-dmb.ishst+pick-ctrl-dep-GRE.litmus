AArch64 MP+GRE-dmb.ishst+pick-ctrl-dep-GRE
Variant=vmsa
{
 [PTE(x)]=(oa:PA(x),attrs:(Device-GRE));
 0:X1=x; 1:X1=x;
 0:X3=y; 1:X3=y;
}
 P0          | P1                  ;
 MOV W0,#1   | LDR W0,[X3]         ;
 STR W0,[X1] | CMP W0,#1           ;
 DMB ST      | CSEL W4,WZR,WZR,EQ  ;
 MOV W2,#1   | CBNZ W4,L0          ;
 STR W2,[X3] |L0:                  ;
             | LDR W2,[X1]         ;
exists(1:X0=1 /\ 1:X2=0)
