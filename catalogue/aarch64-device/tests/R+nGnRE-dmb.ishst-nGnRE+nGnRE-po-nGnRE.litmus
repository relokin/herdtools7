AArch64 R+nGnRE-dmb.ishst-nGnRE+nGnRE-po-nGnRE
Variant=vmsa
{
 [PTE(x)]=(oa:PA(x),attrs:(Device-nGnRE));
 [PTE(y)]=(oa:PA(y),attrs:(Device-nGnRE));
 0:X1=x; 1:X1=x;
 0:X3=y; 1:X3=y;
}
