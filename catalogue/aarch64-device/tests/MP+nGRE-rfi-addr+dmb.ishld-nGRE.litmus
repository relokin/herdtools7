AArch64 MP+nGRE-rfi-addr+dmb.ishld-nGRE
Variant=vmsa
{
[PTE(x)]=(attrs:(Device-nGRE));
0:X1=x; 0:X3=y;
1:X1=x; 1:X3=y;
}
 P0                  | P1          ;
 MOV W0,#1           | LDR W2,[X3] ;
 STR W0,[X1]         | DMB ISHLD   ;
 LDR W4,[X1]         | LDR W0,[X1] ;
 EOR W5,W4,W4        |             ;
 MOV W2,#1           |             ;
 STR W2,[X3,W5,SXTW] |             ;
exists (0:X4=1 /\ 1:X2=1 /\ 1:X0=0)
